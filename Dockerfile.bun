# Builder image for building the pi bun binary for linux-arm64 natively inside
# Docker (`make bun-linux-arm64`, and `make bun-linux-arm64-musl` for the musl
# variant used by Alpine-based environments). Deno is out of scope.
#
# Docker runs the linux/arm64 image natively on Apple Silicon (the Makefile
# pins --platform linux/arm64), so nothing is cross-compiled: the Bun download
# and `bun build --compile` both target the container's own platform.
#
# Vanilla Alpine Linux (latest stable) with the Bun binary downloaded directly
# from GitHub releases (no npm package). The workspace is copied in,
# dependencies are installed with npm, the workspace is built offline
# (checked-in model data), and the standalone binary is produced natively. The
# Makefile targets run this image with a named volume at /artifacts (no bind
# mounts) and extract the binary to the host. The output is verified with
# elfutils (scripts/verify-binary.sh) before it is staged.
FROM alpine:3.24

# Alpine 3.24 ships Node 24.x. The workspace builds run .ts scripts directly
# (e.g. `node scripts/check-model-data.ts`), which requires Node >= 23.6 type
# stripping. gcompat + libstdc++ let the glibc Bun build run on Alpine; no
# dependency lifecycle scripts run (npm ci --ignore-scripts).
RUN apk add --no-cache nodejs npm git curl unzip gcompat libstdc++ elfutils

WORKDIR /app
COPY . .

# The source sha baked into version.generated.ts (reported by pi -v).
# PI_SOURCE_SHA comes from the host as a build arg (the Makefile passes the
# git sha, since .git is excluded from the build context); the coding-agent
# build script regenerates version.generated.ts from this env before tsgo
# runs, so the value lands in dist regardless of whether git is available.
ARG PI_SOURCE_SHA=unknown
ENV PI_SOURCE_SHA=${PI_SOURCE_SHA}

# Install workspace dependencies and build all packages offline. This stays
# before the Bun download/compile steps so Bun flavor changes reuse the cached
# dependency and build layers.
RUN npm ci --ignore-scripts \
    && npm run build:offline

# Direct Bun binary download. Bun 1.3.14 ships glibc (bun-linux-aarch64.zip)
# and musl (bun-linux-aarch64-musl.zip) builds; gcompat makes the glibc build
# run on Alpine. The output binary's linkage follows the Bun flavor (glibc by
# default, musl when BUN_FLAVOR=musl), so the build verifies it against
# EXPECTED_LINKAGE after compiling.
ARG BUN_VERSION=1.3.14
ARG BUN_FLAVOR=
RUN flavor_suffix=; \
    if test -n "$BUN_FLAVOR"; then flavor_suffix="-musl"; fi; \
    curl -fsSL -o /tmp/bun.zip \
        "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-aarch64${flavor_suffix}.zip" \
    && unzip -o /tmp/bun.zip -d /tmp/bun \
    && mv "/tmp/bun/bun-linux-aarch64${flavor_suffix}/bun" /usr/local/bin/bun \
    && chmod +x /usr/local/bin/bun \
    && rm -rf /tmp/bun /tmp/bun.zip

# Build the standalone binaries natively (no --target: the container platform is
# the target platform). Both the full TUI binary (`pi-bun`) and the headless
# binary (`pi-headless`, TUI stubbed out via headless/build-headless.mts) are
# produced. The elfutils linkage check fails the build when the output does not
# match EXPECTED_LINKAGE.
ARG EXPECTED_LINKAGE=glibc
RUN cd packages/coding-agent \
    && bun build --compile ./dist/bun/cli.js \
        --outfile /app/pi-bun \
    && /app/scripts/verify-binary.sh /app/pi-bun "$EXPECTED_LINKAGE" \
    && bun scripts/build-headless.mts /app/pi-headless \
    && /app/scripts/verify-binary.sh /app/pi-headless "$EXPECTED_LINKAGE"

# Default command: stage both binaries into the named volume mounted at
# /artifacts by the Makefile targets.
CMD ["sh", "-ec", \
  "cp /app/pi-bun /artifacts/pi-bun && chmod +x /artifacts/pi-bun && cp /app/pi-headless /artifacts/pi-headless && chmod +x /artifacts/pi-headless"]
